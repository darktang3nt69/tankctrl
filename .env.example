# TankCtl Environment Configuration
# Copy this file to .env and update values for your environment
# Use Docker service names (mosquitto, postgres, timescaledb) when running in Docker,
# or 'localhost' when running the backend directly on your machine.

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ── MQTT (Mosquitto) ───────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=tankctl
MQTT_PASSWORD=password
# Paths as mounted into the backend container (see docker-compose.yml).
# Backend writes per-device credentials/ACLs here on registration and
# reloads the broker via the mosquitto container name below.
MQTT_PASSWD_FILE=/mosquitto/config/auth/passwd
MQTT_ACL_FILE=/mosquitto/config/auth/acl
MQTT_BROKER_CONTAINER_NAME=tankctl-mosquitto

# ── PostgreSQL (operational DB) ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tankctl
POSTGRES_USER=tankctl
POSTGRES_PASSWORD=password

# ── TimescaleDB (telemetry DB) ─────────────────────────────────────────────────
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_DB=tankctl_telemetry
TIMESCALE_USER=tankctl
TIMESCALE_PASSWORD=password

# ── Application ────────────────────────────────────────────────────────────────
APP_TIMEZONE=Asia/Kolkata

# ── Scheduler ──────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
DEVICE_OFFLINE_TIMEOUT=60
SHADOW_RECONCILIATION_INTERVAL=10
OFFLINE_DETECTION_INTERVAL=30

# ── Alerts ─────────────────────────────────────────────────────────────────────
ALERTS_ENABLED=true
ALERT_MIN_INTERVAL_SECONDS=600
ALERT_TEMPERATURE_HIGH_C=30
ALERT_TEMPERATURE_LOW_C=20

# ── Grafana ────────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
